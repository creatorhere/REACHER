GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
MAX_NEW_TOKENS=4096
CHUNK_CHARS=8000
GEMINI_CONCURRENCY=3
MAX_UPLOAD_MB=200
MAX_BATCH_FILES=10
MAX_BATCH_MB=512
RESUMABLE_UPLOAD_THRESHOLD_MB=32
CROSSREF_MAILTO=
PORT=8080

# Local development uses in-process jobs. Set google only for Cloud Run.
CLOUD_BACKEND=local
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_LOCATION=asia-south1
FIRESTORE_DATABASE=(default)
CLOUD_TASKS_QUEUE=reacher-reviews
CLOUD_TASKS_LOCATION=asia-south1
WORKER_SERVICE_URL=
TASK_SERVICE_ACCOUNT=
SIGNED_URL_SERVICE_ACCOUNT=
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=1800
CLOUD_TASKS_MAX_ATTEMPTS=20

# Optional exact browser origins for a separately hosted frontend. Same-origin is default.
CORS_ALLOWED_ORIGINS=
